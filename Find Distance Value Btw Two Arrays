class Solution:
    def findTheDistanceValue(self, arr1: list[int], arr2: list[int], d: int) -> int:
        count = 0
        for num in arr1:
            res = True
            for arr in arr2:
                if abs(num - arr) <= d:
                    res = False
                    break
            if res:
                count += 1
        return count


        
