class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        characters = {}
        left = 0
        max_len = 0
        for right, char in enumerate(s):
            if char in characters and characters[char] >= left:
                left = characters[char] + 1
            characters[char] = right
            max_len = max(max_len, right - left + 1)
        return max_len

        
