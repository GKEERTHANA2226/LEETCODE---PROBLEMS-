class Solution:
    def maxVowels(self, s: str, k: int) -> int:
        vowels = {'a','e','i','o','u'}
        count_k = sum(1 for i in range(k) if s[i] in vowels)
        max_k = count_k
        for i in range(k, len(s)):
            if s[i] in vowels:
                count_k += 1
            if s[i - k] in vowels:
                count_k -= 1
            max_k = max(count_k, max_k)
        return max_k
        
        
