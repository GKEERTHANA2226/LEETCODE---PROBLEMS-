class Solution:
    def minAddToMakeValid(self, s: str) -> int:
        A = 0
        B = 0
        for char in s:
            if char == '(':
                A += 1
            elif char == ')':
                if A > 0:
                    A -= 1
                else:
                    B += 1
        return A + B
                
                


        
