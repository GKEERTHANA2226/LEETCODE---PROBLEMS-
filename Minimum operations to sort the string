class Solution:
    def minOperations(self, s: str) -> int:
        length = len(s)
        if s == "".join(sorted(s)):
            return 0
        if length == 2:
            return -1
        if s[0] == min(s) or s[-1] == max(s):
            return 1
        if s[0] == max(s) and s[-1] == min(s) and s.count(max(s)) == 1 and s.count(min(s)) == 1:
            return 3
        return 2
        
        
