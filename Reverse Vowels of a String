class Solution:
    def reverseVowels(self, s: str) -> str:
        vowel = set("aeiouAEIOU")
        vowels = [char for char in s if char in vowel]
        s_list = list(s)
        for i in range(len(s_list)):
            if s_list[i] in vowel:
                s_list[i] = vowels.pop()
        return "".join(s_list)
       
