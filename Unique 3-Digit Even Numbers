class Solution:
    def totalNumbers(self, digits: List[int]) -> int:
        repeated = Counter(digits)
        res = 0
        for num in range(100, 1000, 2):
            d1 = num // 100
            d2 = (num // 10) % 10
            d3 = num % 10
            rep = Counter([d1,d2,d3])
            if all(repeated[d] >= rep[d] for d in rep):
                res += 1
        return res
        
        
