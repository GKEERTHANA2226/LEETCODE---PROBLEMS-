class Solution:
    def wordPattern(self, pattern: str, s: str) -> bool:
        count = 0
        words = s.split()
        if len(pattern) != len(words):
            return False
        p_to_w = {}
        w_to_p = {}
        
        for char, word in zip(pattern, words):
            if char in p_to_w and p_to_w[char] != word:
                return False
            if word in w_to_p and w_to_p[word] != char:
                return False
                
            p_to_w[char] = word
            w_to_p[word] = char
            
        return True
